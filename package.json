{
  "name": "Ping",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only",
    "android:dev": "react-native run-android --active-arch-only --mode devDebug --appIdSuffix dev",
    "android:qa": "react-native run-android --active-arch-only --mode qaDebug --appIdSuffix qa",
    "android:prod": "react-native run-android --active-arch-only --mode prodDebug",
    "build:dev": "cd android && gradlew.bat assembleDevRelease",
    "build:qa": "cd android && gradlew.bat assembleQaRelease",
    "build:prod": "cd android && gradlew.bat assembleProdRelease",
    "bundle:prod": "cd android && gradlew.bat bundleProdRelease",
    "clean:android": "cd android && gradlew.bat clean",
    "dev": "adb reverse tcp:8081 tcp:8081 && react-native start",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "postinstall": "patch-package",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^21.8.0",
    "@react-native-firebase/auth": "^21.8.0",
    "@react-native-firebase/messaging": "^21.14.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native/new-app-screen": "0.87.1",
    "@tanstack/query-sync-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "axios": "^1.20.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-device-info": "^14.0.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "^1.22.6",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
